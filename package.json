{
  "name": "fire-fight-flux",
  "version": "0.1.0",
  "description": "FIRE FIGHT FLUX: fireball boxing for the glasses. Passthrough only, hands only, bosses first. Built on the Immersive Web SDK.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:hands": "node --experimental-strip-types --no-warnings tools/hand-check.mjs",
    "check:smoke": "node tools/smoke-check.mjs",
    "check:titans": "node tools/titan-check.mjs",
    "check:strike": "node --experimental-strip-types --no-warnings tools/strike-check.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "0.4.2",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@iwsdk/vite-plugin-dev": "0.4.2",
    "@types/three": "0.184.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
